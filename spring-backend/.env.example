# Spring backend env vars. Copy to `.env` and fill in values. The
# bootRun task picks them up automatically when sourced into the shell.

# --- Database (Postgres for real dev; default H2 in-memory if unset) ---
DB_PASSWORD=

# --- Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
# Legacy single price (only set if you have pre-split subscriptions to support)
STRIPE_PRICE_ID=
CHECKOUT_SUCCESS_URL=http://localhost:3000/?upgraded=true
CHECKOUT_CANCEL_URL=http://localhost:3000/?upgrade_cancelled=true
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/#/upgrade

# --- LLM providers ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-3.1-pro-preview

# --- GCP (only required for Cloud SQL, Vertex AI, GCS storage) ---
GCP_PROJECT=
GCP_LOCATION=global
GCS_BUCKET=

# --- Admin allowlist (comma-separated emails) ---
ADMIN_EMAILS=

# --- Feature flags ---
# Comma-separated list of emails exempt from the monthly usage cap.
USAGE_UNLIMITED_EMAILS=
DEV_MODE=true
