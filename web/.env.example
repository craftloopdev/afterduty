# Copy to .env.local and fill in. .env* is gitignored.
#
# Naming: SS_* = server-only (BFF, never shipped to the browser);
#         NEXT_PUBLIC_* = inlined into the client bundle at build time.

# ── Server-only (BFF) ──
# Spring backend base URL, including the /api prefix.
SS_API_BASE_URL=http://localhost:8080/api

# Apple App Site Association appID for universal links (capacitor-ios-spec §B.5).
# Format: <TEAMID>.com.afterduty.app. Override the in-code default ONLY to inject
# the verified production Apple Developer Team ID for app 6771148030 without a code
# change. If unset, the route serves the documented default.
# APPLE_APP_SITE_ASSOCIATION_APP_ID=3ZKP4S469J.com.afterduty.app

# ── Public Firebase web config (same Firebase project as the mobile app) ──
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef

# ── Native (Capacitor) build only (capacitor-ios-spec §A.1) ──
# Required at build time for `npm run build:native`. The API base is the REAL
# Spring origin (no BFF hop natively); the RevenueCat iOS SDK key is a PUBLIC
# value, safe to embed.
NEXT_PUBLIC_API_BASE=https://api.afterduty.app/api
NEXT_PUBLIC_REVENUECAT_IOS_KEY=appl_XuvonHELPKuXURtGzVeGYQklSPF
# Google Play RevenueCat SDK key (goog_…) — PUBLIC, safe to embed (like the iOS key).
# From the RevenueCat "VA Claim Path (Play Store)" app (repointed to com.vaclaimpath.app).
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=goog_pkNvKNZyMAeCnnXUPqVsqrFYsjw
